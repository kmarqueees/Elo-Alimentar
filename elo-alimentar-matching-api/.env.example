# Copie este arquivo para ".env" e ajuste se precisar:  cp .env.example .env
# O ".env" não vai para o git; este exemplo vai.

# ---------------------------------------------------------------------------
# Banco de dados (só para "npm run dev" e "npm run db:*"; o modo
# "npm run dev:memory" não usa banco). Os valores abaixo batem com o docker-compose.yml.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://docker:docker@localhost:5432/elo_alimentar?schema=public"

# Banco usado SÓ pelos testes de integração ("npm run test:int").
# ATENÇÃO: esse teste APAGA os dados do banco apontado aqui. Nunca use o banco de desenvolvimento.
TEST_DATABASE_URL="postgresql://docker:docker@localhost:5432/elo_alimentar_test?schema=public"

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
# Porta da API (o front end espera 3333 por padrão).
PORT=3333

# ---------------------------------------------------------------------------
# Oferta sequencial
# ---------------------------------------------------------------------------
# Minutos que a instituição tem para aceitar ou recusar uma oferta (padrão: 30).
# Dica para demonstrar: use 12 para ver o lembrete (chega 10 min antes do prazo) e a expiração em poucos minutos.
OFFER_TIMEOUT_MINUTES=30

# De quantos em quantos milissegundos a fila de ofertas anda: expira ofertas sem resposta,
# oferece à próxima instituição, envia lembretes e vence lotes (padrão: 15000 = 15 s).
OFFER_QUEUE_INTERVAL_MS=15000

# ---------------------------------------------------------------------------
# Busca de endereço (CEP pelo ViaCEP, mapa pelo Nominatim/OpenStreetMap)
# ---------------------------------------------------------------------------
# A política de uso do Nominatim pede que a aplicação se identifique, de preferência com um contato.
# Troque pelo seu e-mail antes de publicar. Padrão: "EloAlimentar/1.0".
GEOCODER_USER_AGENT="EloAlimentar/1.0 (contato: seu-email@exemplo.com)"
