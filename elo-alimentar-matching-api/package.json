{
  "name": "elo-alimentar-matching",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Núcleo de matching multicritério do Elo Alimentar (TCC)",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.int.config.ts",
    "simulate": "tsx src/simulation/run-simulation.ts",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx src/infra/database/prisma/seed.ts",
    "db:test:prepare": "node scripts/prepare-test-db.mjs",
    "dev": "tsx watch src/main/server.ts",
    "dev:memory": "tsx watch src/main/server-memory.ts"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "prisma": "6.18.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.0.3",
    "vitest": "4.0.16"
  },
  "dependencies": {
    "@prisma/client": "6.18.0",
    "dotenv": "17.2.3",
    "fastify": "5.6.1",
    "zod": "4.1.12"
  }
}
